# GlobalCommerce 환경 변수 (이름과 위치의 정본: products/02_ARCHITECTURE.md 8절, 9절)
#
# 사용법: cp .env.example .env.local   (.env.local 은 커밋하지 않는다)
# - Docker(pnpm dev:docker)와 로컬(pnpm dev) 모두 저장소 루트의 .env.local 을 읽는다.
# - 아래 값은 로컬 전용 기본값이다. 실제 키는 넣지 않아도 가짜 어댑터(*_PROVIDER=fake)로 동작한다.
# - NEXT_PUBLIC_* 는 브라우저에 노출된다. 비밀 값(SERVICE_ROLE, OPENAI, ANTHROPIC, TOSS_SECRET)을 쓰지 않는다.

# ---------------------------------------------------------------------------
# Supabase (로컬 스택 값은 `supabase start` 출력의 anon key / service_role key)
# ---------------------------------------------------------------------------
# 브라우저가 접속하는 주소
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버(웹 서버 · 워커)만 쓴다
SUPABASE_SERVICE_ROLE_KEY=
# 컨테이너(web · worker)가 Supabase 에 붙는 주소. Docker Desktop 의 host.docker.internal 사용 (GC-D-26).
# 컨테이너 밖에서 pnpm dev 로 실행할 때는 비워 두면 NEXT_PUBLIC_SUPABASE_URL 을 쓴다.
SUPABASE_URL_INTERNAL=http://host.docker.internal:54321

# ---------------------------------------------------------------------------
# 앱
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ID=globalcommerce

# ---------------------------------------------------------------------------
# 인증 (9절). 로컬은 mock, 배포는 live. 배포 환경에서 mock 이면 기동 실패.
# ---------------------------------------------------------------------------
AUTH_MODE=mock
# live 에서만: google,email 등
AUTH_PROVIDERS=
# 로컬 시드 계정 비밀번호(로컬 전용 임의 값). NEXT_PUBLIC_ 을 붙이지 않는다.
DEV_SEED_PASSWORD=local-dev-only-change-me

# ---------------------------------------------------------------------------
# 외부 API 어댑터. 로컬 기본값은 가짜(fake). 키를 넣고 live 로 바꾸면 실제 호출.
# ---------------------------------------------------------------------------
AMAZON_DATA_PROVIDER=fake
MARKETS_PROVIDER=fake
AI_PROVIDER=fake
PAYMENT_PROVIDER=fake
EXCHANGE_RATE_PROVIDER=fake
DATALAB_PROVIDER=fake
# openai-image | fal-flux (O-04)
IMAGE_COMPOSE_PROVIDER=openai-image

# ---------------------------------------------------------------------------
# 비밀 키 (모두 서버 전용, 비워 두면 해당 기능 비활성 또는 가짜 어댑터)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAL_KEY=
AMAZON_DATA_API_KEY=
KOREAEXIM_API_KEY=
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# 결제 (W1). TOSS_CLIENT_KEY 만 공개 가능
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# 자격 증명 암호화 AES-256-GCM (W1). CREDENTIALS_KEY_V<n> 형식으로 버전별 키를 추가한다. 0키 폴백 금지.
CREDENTIALS_KEY_VERSION=
# CREDENTIALS_KEY_V1=

# 이메일 알림 (제공자 미정)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# R2
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# ---------------------------------------------------------------------------
# 워커
# ---------------------------------------------------------------------------
WORKER_ID=main
# main | media (R2)
WORKER_ROLE=main
WORKER_CONCURRENCY=4

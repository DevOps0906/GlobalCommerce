# 로컬 개발 전용 이미지 (GC-D-26). 비밀 값은 넣지 않는다: 빌드 인자 없음, .env* 복사 없음.
# 소스는 docker-compose.yml 에서 마운트하고, 의존성 설치는 컨테이너 시작 때 한다.
FROM node:22-bookworm-slim

ENV CI=true \
    NEXT_TELEMETRY_DISABLED=1 \
    WATCHPACK_POLLING=true

RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

WORKDIR /app

EXPOSE 3000
